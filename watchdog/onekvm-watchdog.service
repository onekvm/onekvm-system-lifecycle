[Unit]
Description=OneKVM process watchdog
Documentation=file:///usr/share/doc
After=dbus.socket onekvm.service
Wants=dbus.socket
ConditionKernelCommandLine=!onekvm.recovery
ConditionKernelCommandLine=!onekvm.nfsroot=1

[Service]
Type=simple
# Timeout is 60s. Core emits Heartbeat at most every 10s. Capture FPS
# and a blanked HDMI display are not watchdog inputs.
# This process owns /dev/watchdog0 (not systemd RuntimeWatchdogSec).
# systemctl stop → SIGTERM magic-closes DesignWare. Crash/SIGKILL leaves
# it armed; Restart=on-failure reopens it, otherwise hardware resets.
ExecStart=/usr/libexec/onekvm/onekvm-watchdog
Restart=on-failure
RestartSec=2s
WatchdogSec=0
# Stay out of the OneKVM slice so a wedged server cgroup cannot starve us.
Slice=system.slice
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

#!/bin/sh
set -eu

# Keep failure context in RAM even when userdata cannot be written. No logs or
# credentials are copied here; the local screen can read this without Core.
stage=boot-slot
status_root=${ONEKVM_PERSISTENCE_STATUS_DIR:-/run/onekvm}
write_status() {
    (
        umask 077
        mkdir -p "$status_root"
        printf 'state=%s\nstage=%s\nexit_code=%s\n' "$1" "$stage" "$2" \
            >"$status_root/.persistence-status.tmp"
        mv -f "$status_root/.persistence-status.tmp" "$status_root/persistence-status"
    ) 2>/dev/null || :
}
progress() {
    stage=$1
    write_status running 0
}
on_exit() {
    persistence_exit=$?
    trap - EXIT
    if [ "$persistence_exit" -eq 0 ]; then
        stage=ready
        write_status ready 0
    else
        write_status failed "$persistence_exit"
        printf 'OneKVM persistence failed: stage=%s exit_code=%s\n' "$stage" "$persistence_exit" >&2 || :
    fi
    exit "$persistence_exit"
}
trap on_exit EXIT
write_status running 0

slot=
for argument in $(cat /proc/cmdline); do
    case "$argument" in
        rauc.slot=A) slot=A ;;
        rauc.slot=B) slot=B ;;
        onekvm.nfsroot=1) slot=dev ;;
    esac
done
[ -n "$slot" ] || { echo "missing rauc.slot" >&2; exit 1; }

data_root=/data/onekvm
storage_root=/mnt/storage/onekvm
config_root=$storage_root/config
config_marker=$storage_root/.etc-migrated
kernel_release=$(uname -r)
module_updates=/usr/lib/modules/$kernel_release/updates
persistent_module_updates=$storage_root/kernel-modules/$slot/$kernel_release/updates
kernel_magic=
if [ -f /usr/share/onekvm/kernel-magic ]; then
    kernel_magic=$(cat /usr/share/onekvm/kernel-magic)
    kernel_hash=${kernel_magic#sha256:}
    case "$kernel_hash" in
        ''|*[!0-9a-f]*) echo 'invalid image kernel magic' >&2; exit 1 ;;
    esac
    [ "$kernel_magic" = "sha256:$kernel_hash" ] && [ "${#kernel_hash}" -eq 64 ] || {
        echo 'invalid image kernel magic' >&2; exit 1;
    }
    persistent_module_updates=$storage_root/kernel-modules/$slot/$kernel_release/$kernel_hash/updates
fi
machines_root=$storage_root/machines
machines_marker=$storage_root/.machines-migrated
machines_mount=/var/lib/machines
opkg_root=/data/pkg-state/slots/$slot/opkg
baseline=/usr/share/onekvm/opkg-baseline
immutable_root=/mnt/.rofs
[ -d "$immutable_root/usr" ] || immutable_root=/rofs

progress runtime
mkdir -p /run/onekvm
rm -rf /run/onekvm/opkg-gpg
mkdir -p /run/onekvm/opkg-gpg
chmod 0700 /run/onekvm/opkg-gpg
progress package-keys
cp -a /etc/opkg/gpg/. /run/onekvm/opkg-gpg/
chmod 0600 /run/onekvm/opkg-gpg/pubring.kbx \
    /run/onekvm/opkg-gpg/trustdb.gpg

progress config
mkdir -p "$config_root"
if [ ! -e "$config_marker" ]; then
    if [ ! -L /etc/onekvm ] || [ "$(readlink /etc/onekvm)" != "$config_root" ]; then
        cp -a /etc/onekvm/. "$config_root/"
    fi
    : >"$config_marker"
fi
rm -rf /etc/onekvm
ln -s "$config_root" /etc/onekvm

progress data
mkdir -p \
    "$data_root/apps" \
    "$data_root/app-data/core" \
    "$config_root/extensions" \
    /data/pkg-state/opkg/lists \
    /data/pkg-state/opkg/cache \
    /data/rauc \
    "$opkg_root"
chmod 0700 "$config_root/extensions"
# /var/log and /var/tmp point into volatile storage. Its directories may
# not exist until tmpfiles runs later in boot; mkdir cannot traverse a
# dangling directory symlink. Leave their creation to that service then.
progress volatile
if [ -d /var/log ]; then
    mkdir -p /var/log/onekvm
fi
if [ -d /var/tmp ]; then
    mkdir -p /var/tmp/onekvm/extension-uploads
    chmod 0700 /var/tmp/onekvm /var/tmp/onekvm/extension-uploads
fi

# The root filesystem itself uses overlayfs.  An mstack needs its writable
# data and work directories on a native filesystem because overlayfs cannot
# use another overlayfs mount as its upper layer.  Preserve existing machine
# images by copying them once before hiding the old root-overlay directory.
progress machines
mkdir -p "$machines_mount" "$machines_root"
if ! mountpoint -q "$machines_mount"; then
    if [ ! -e "$machines_marker" ]; then
        cp -a "$machines_mount/." "$machines_root/"
        : >"$machines_marker"
    fi
    mount --bind "$machines_root" "$machines_mount"
fi

if [ ! -e /etc/opkg/onekvm-feed.conf ]; then
    cp /usr/share/onekvm/defaults/opkg/feeds.conf \
        /etc/opkg/onekvm-feed.conf
fi

progress build-id
current_build_id=$(cat /usr/share/onekvm/build-id)
slot_build_id=
if [ -f "$opkg_root/.baseline-build-id" ]; then
    slot_build_id=$(cat "$opkg_root/.baseline-build-id")
fi

slot_kernel_magic=
if [ -f "$opkg_root/.baseline-kernel-magic" ]; then
    slot_kernel_magic=$(cat "$opkg_root/.baseline-kernel-magic")
fi
if [ "$slot_build_id" != "$current_build_id" ] || [ "$slot_kernel_magic" != "$kernel_magic" ]; then
    # The root overlay is shared by A/B slots, so an older package payload can
    # hide a newer immutable file. Refresh only regular baseline files that
    # differ; leave local content and the slot-aware module tree alone.
    progress image-files
    for package_list in "$baseline"/info/*.list; do
        [ -f "$package_list" ] || continue
        while read -r installed_path _; do
            case "$installed_path" in
                /usr/local/*|/usr/lib/modules/*)
                    continue
                    ;;
                /usr/*)
                    immutable_path=$immutable_root$installed_path
                    [ -f "$immutable_path" ] || continue
                    if [ ! -f "$installed_path" ] || ! cmp -s "$immutable_path" "$installed_path"; then
                        mkdir -p "$(dirname "$installed_path")"
                        cp -a "$immutable_path" "$installed_path"
                    fi
                    ;;
            esac
        done <"$package_list"
    done
fi

if [ "$slot_build_id" != "$current_build_id" ] || [ "$slot_kernel_magic" != "$kernel_magic" ]; then
    progress packages
    rm -rf "$opkg_root"
    mkdir -p "$opkg_root"
    cp -a "$baseline/." "$opkg_root/"
    cp /usr/share/onekvm/build-id "$opkg_root/.baseline-build-id"
    printf '%s\n' "$kernel_magic" >"$opkg_root/.baseline-kernel-magic"
fi

# Local IPKS bundles may contain optional kernel modules.  Their opkg state is
# persistent, so their payload must not live only in the root overlay: an
# image rewrite can replace that overlay while retaining userdata and leave
# opkg reporting a package as installed even though its .ko files vanished.
# Keep only the optional updates tree on userdata and isolate it by slot and
# kernel release.  The immutable in-image module tree and ABI metadata remain
# with each rootfs.  Synchronize only files owned by packages recorded in the
# image baseline or this slot rather than copying arbitrary stale files from a
# root overlay that may previously have been shared by both slots.
progress modules
mkdir -p "$module_updates" "$persistent_module_updates"
if ! mountpoint -q "$module_updates"; then
    # Seed modules shipped by the current immutable image as well as modules
    # installed later by extension bundles.  Repeat the comparison on every
    # boot because successive images can intentionally share uname -r.
    for package_list in \
        "$baseline"/info/onekvm-kernel-module-*.list \
        "$opkg_root"/info/onekvm-kernel-module-*.list; do
        [ -f "$package_list" ] || continue
        if [ -n "$kernel_magic" ] && ! grep -Fxq \
            "X-OneKVM-Kernel-Magic: $kernel_magic" "${package_list%.list}.control"; then
            echo "Ignoring module package without matching kernel magic: $package_list" >&2
            continue
        fi
        while read -r installed_path _; do
            case "$installed_path" in
                "$module_updates"/*.ko)
                    relative_path=${installed_path#"$module_updates"/}
                    module_source=$installed_path
                    # An opaque directory in the writable overlay can hide
                    # modules in the newly booted immutable rootfs.  Prefer
                    # the immutable root whenever it contains this baseline module.
                    if [ -f "$immutable_root$installed_path" ]; then
                        module_source=$immutable_root$installed_path
                    fi
                    [ -f "$module_source" ] || continue
                    module_destination=$persistent_module_updates/$relative_path
                    if [ ! -f "$module_destination" ] || ! cmp -s "$module_source" "$module_destination"; then
                        mkdir -p "$(dirname "$module_destination")"
                        cp -a "$module_source" "$module_destination"
                    fi
                    ;;
            esac
        done <"$package_list"
    done
    mount --bind "$persistent_module_updates" "$module_updates"
    if [ -n "$(find "$persistent_module_updates" -type f -name '*.ko' -print -quit)" ]; then
        depmod -a "$kernel_release"
    fi
fi

ln -sfn "$opkg_root" /run/onekvm/opkg
printf '%s\n' "$slot" >/run/onekvm/slot

[Unit]
Description=OneKVM temporary USB ADB debugging
After=systemd-udev-settle.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/libexec/onekvm/usb-adb-debug
ExecStopPost=/usr/libexec/onekvm/usb-adb-debug cleanup
TimeoutStartSec=25s
TimeoutStopSec=20s
KillMode=mixed
Restart=no
RuntimeDirectory=onekvm-adb-debug
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
